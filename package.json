{
  "name": "perx-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:vercel": "node scripts/vercel-build.mjs",
    "lint": "turbo run lint",
    "check": "turbo run check",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "ci:web": "npm run check && npm run test && npm run lint && npm run build"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.8",
    "turbo": "^2.3.3",
    "vitest": "^4.0.8"
  },
  "packageManager": "npm@10.8.2"
}
