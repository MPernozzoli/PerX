ENV=prod
DEBUG=False
# ENV=prod/staging refuses to start with a placeholder or <32 chars secret:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret
PORTAL_APP_URL=http://localhost:3001
PORTAL_DEBUG_PREVIEW_LINKS=False
PORTAL_DEV_CLAIM_REFERENCE_ONLY_AUTH=False
ROUTING_RESOLVE_SECRET=replace-with-routing-resolve-secret
# Leave empty to keep /communications/provider-webhook disabled.
COMMUNICATIONS_WEBHOOK_SECRET=


SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=perx-portal-uploads
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GMAIL_SYNC_ENABLED=True
GMAIL_SYNC_POLL_SECONDS=90
APP_PUBLIC_URL=https://app.perx.it
LOGIN_PUBLIC_URL=https://login.perx.it
FF_CLOUD_AUTH_ENABLED=True
FF_AUTOMATIONS_ENABLED=False
FF_PORTAL_PHOTO_AI_ANALYSIS_ENABLED=True
FF_PORTAL_PHOTO_ANTIFRAUD_ENABLED=True
AUTOMATION_POLL_SECONDS=3600
LOCAL_AI_WORKER_SHARED_SECRET=replace-with-worker-shared-secret
PORTAL_PHOTO_SIGNED_URL_EXPIRE_SECONDS=86400

APP_ADMIN_EMAIL=info@pynkstudio.it
APP_ADMIN_FULL_NAME=Pynk Studio Admin
APP_ADMIN_DEFAULT_PASSWORD=change-me-now
SINGLE_TENANT_MODE=False
SINGLE_TENANT_ID=perx-single-tenant
SINGLE_TENANT_NAME=PerX Studio
SINGLE_TENANT_SLUG=perx-studio
SINGLE_TENANT_ADMIN_EMAIL=admin@example.com
SINGLE_TENANT_ADMIN_FULL_NAME=Admin PerX
SINGLE_TENANT_ADMIN_PASSWORD=replace-with-admin-password

RESEND_API_KEY=replace-with-resend-api-key
RESEND_DEFAULT_FROM_EMAIL=admin@example.com
RESEND_SCHEDULED_EMAILS_ENABLED=True
RESEND_SCHEDULED_EMAIL_POLL_SECONDS=30
RESEND_SCHEDULED_EMAIL_BATCH_SIZE=25

VAULT_STORAGE_PROVIDER=mac_mini
VAULT_STORAGE_ROOT=/tmp/perx-hub-compat
MAC_MINI_STORAGE_URL=https://macmini.perx.internal
MAC_MINI_STORAGE_TOKEN=replace-with-shared-storage-token

# --- Vault su S3 (PREDISPOSTO, NON ATTIVO: il provider resta quello sopra) ---
# Per attivarlo in futuro: VAULT_STORAGE_PROVIDER=s3 dopo aver migrato i file
# (scripts/migrate_vault_to_s3.py). Credenziali dalla catena AWS standard
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY o IAM role), mai in questo file.
# VAULT_S3_BUCKET=perx-vault
# VAULT_S3_REGION=eu-south-1
# VAULT_S3_PREFIX=
# VAULT_S3_PRESIGNED_URL_TTL_SECONDS=300
# VAULT_S3_PRESIGNED_DOWNLOADS=false
# Simulazione locale S3 con moto server (docker compose -f docker-compose.storage.yml up -d):
# VAULT_STORAGE_PROVIDER=s3
# VAULT_S3_BUCKET=perx-vault-dev
# VAULT_S3_ENDPOINT_URL=http://127.0.0.1:9000
# VAULT_S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
