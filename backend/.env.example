ENV=prod
DEBUG=False
SECRET_KEY=replace-with-a-random-secret
PORTAL_APP_URL=http://localhost:3001
PORTAL_DEBUG_PREVIEW_LINKS=True
PORTAL_DEV_CLAIM_REFERENCE_ONLY_AUTH=False
ROUTING_RESOLVE_SECRET=replace-with-routing-resolve-secret


SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=perx-portal-uploads
APP_PUBLIC_URL=https://app.perx.it
LOGIN_PUBLIC_URL=https://login.perx.it
FF_CLOUD_AUTH_ENABLED=True
FF_AUTOMATIONS_ENABLED=False
FF_PORTAL_PHOTO_AI_ANALYSIS_ENABLED=True
FF_PORTAL_PHOTO_ANTIFRAUD_ENABLED=True
AUTOMATION_POLL_SECONDS=3600
LOCAL_AI_WORKER_SHARED_SECRET=replace-with-worker-shared-secret
PORTAL_PHOTO_SIGNED_URL_EXPIRE_SECONDS=86400

APP_ADMIN_EMAIL=info@pynkstudio.it
APP_ADMIN_FULL_NAME=Pynk Studio Admin
APP_ADMIN_DEFAULT_PASSWORD=change-me-now
SINGLE_TENANT_MODE=False
SINGLE_TENANT_ID=perx-single-tenant
SINGLE_TENANT_NAME=PerX Studio
SINGLE_TENANT_SLUG=perx-studio
SINGLE_TENANT_ADMIN_EMAIL=admin@example.com
SINGLE_TENANT_ADMIN_FULL_NAME=Admin PerX
SINGLE_TENANT_ADMIN_PASSWORD=replace-with-admin-password

RESEND_API_KEY=replace-with-resend-api-key
RESEND_DEFAULT_FROM_EMAIL=admin@example.com
RESEND_SCHEDULED_EMAILS_ENABLED=True
RESEND_SCHEDULED_EMAIL_POLL_SECONDS=30
RESEND_SCHEDULED_EMAIL_BATCH_SIZE=25

VAULT_STORAGE_PROVIDER=mac_mini
VAULT_STORAGE_ROOT=/tmp/perx-hub-compat
MAC_MINI_STORAGE_URL=https://macmini.perx.internal
MAC_MINI_STORAGE_TOKEN=replace-with-shared-storage-token
