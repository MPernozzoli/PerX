ENV=prod
DEBUG=False
SECRET_KEY=replace-with-a-random-secret
PORTAL_APP_URL=http://localhost:3001
PORTAL_DEBUG_PREVIEW_LINKS=True
PORTAL_DEV_CLAIM_REFERENCE_ONLY_AUTH=False


SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
FF_CLOUD_AUTH_ENABLED=True

APP_ADMIN_EMAIL=info@pynkstudio.it
APP_ADMIN_FULL_NAME=Pynk Studio Admin
APP_ADMIN_DEFAULT_PASSWORD=change-me-now

VAULT_STORAGE_PROVIDER=mac_mini
VAULT_STORAGE_ROOT=/tmp/perx-hub-compat
MAC_MINI_STORAGE_URL=https://macmini.perx.internal
MAC_MINI_STORAGE_TOKEN=replace-with-shared-storage-token
