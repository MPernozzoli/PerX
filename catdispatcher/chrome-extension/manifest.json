{
  "manifest_version": 3,
  "name": "ACT CAT Dispatcher",
  "version": "1.6.0",
  "description": "Estensione per assegnazione automatica CAT nel gestionale ACT Jellyfish",
  "author": "CAT Dispatcher Team",
  
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "ACT CAT Dispatcher"
  },

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "identity",
    "webNavigation",
    "notifications",
    "alarms"
  ],

  "host_permissions": [
    "https://act.jfish.it/*",
    "https://*.supabase.co/*",
    "https://accounts.google.com/*",
    "https://catdispatcher.it/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://act.jfish.it/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://catdispatcher.it/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "oauth2": {
    "client_id": "198856872240-urvpcp8jkegfb9tq89ho8qfkj67c3lfh.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },

  "web_accessible_resources": [
    {
      "resources": ["icons/quick-assign-icon.png"],
      "matches": ["https://act.jfish.it/*"]
    }
  ]
}
