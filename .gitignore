# Monorepo npm workspaces: only the root package-lock.json is valid.
# Nested lockfiles inside workspace members cause the npm
# "Tracker idealTree already exists" crash on Vercel.
apps/*/package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn

