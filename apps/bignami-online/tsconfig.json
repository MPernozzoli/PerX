{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strictNullChecks": false,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/components/ui/rich-text-display": [
        "./src/components/ui/rich-text-display.tsx"
      ],
      "@/components/ui/rich-text-editor": [
        "./src/components/ui/rich-text-editor.tsx"
      ],
      "@/components/ui/*": [
        "../../packages/ui/src/components/ui/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "@perx/ui/components/ui/rich-text-display": [
        "./src/components/ui/rich-text-display.tsx"
      ],
      "@perx/ui/components/ui/rich-text-editor": [
        "./src/components/ui/rich-text-editor.tsx"
      ],
      "@perx/ui/components/ui/*": [
        "../../packages/ui/src/components/ui/*"
      ],
      "@perx/ui/lib/utils": [
        "../../packages/ui/src/lib/utils.ts"
      ],
      "@perx/tailwind-config": [
        "../../packages/tailwind-config/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "supabase"
  ]
}
