<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.perx.hub</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/opt/perx-hub/PerXHub</string>
    </array>
    
    <!-- Avvia al boot del sistema (non richiede login utente) -->
    <key>RunAtLoad</key>
    <true/>
    
    <!-- Riavvia automaticamente se crasha o termina -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>
    
    <key>WorkingDirectory</key>
    <string>/opt/perx-hub</string>
    
    <key>StandardOutPath</key>
    <string>/opt/perx-hub/logs/hub.log</string>
    
    <key>StandardErrorPath</key>
    <string>/opt/perx-hub/logs/hub-error.log</string>
    
    <key>EnvironmentVariables</key>
    <dict>
        <key>PERX_ENV</key>
        <string>production</string>
        <key>PERX_HUB_PATH</key>
        <string>/opt/perx-hub</string>
        <key>PERX_HUB_HOST</key>
        <string>0.0.0.0</string>
        <key>PERX_HUB_PORT</key>
        <string>8080</string>
        <!-- Worker URLs -->
        <key>PERX_EMAIL_WORKER_URL</key>
        <string>http://localhost:5001</string>
        <key>PERX_WA_BRIDGE_URL</key>
        <string>http://localhost:5002</string>
        <key>PERX_AUTO_UPDATER_URL</key>
        <string>http://localhost:8084</string>
        <key>PERX_SYNC_AGENT_URL</key>
        <string>https://perx-sync-agent.tailca58be.ts.net</string>
    </dict>
    
    <!-- Esegui come root per accesso completo (daemon) -->
    <key>UserName</key>
    <string>root</string>
    
    <!-- Tipo di processo: Background per daemon h24 -->
    <key>ProcessType</key>
    <string>Background</string>
    
    <!-- Previeni il sonno del sistema mentre il servizio gira -->
    <key>PreventsSleep</key>
    <true/>
    
    <!-- Throttle: attendi almeno 10 secondi prima di riavviare dopo crash -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
    
    <!-- Timeout per terminazione graceful -->
    <key>ExitTimeOut</key>
    <integer>30</integer>
    
    <!-- Nice value: priorità normale -->
    <key>Nice</key>
    <integer>0</integer>
</dict>
</plist>
