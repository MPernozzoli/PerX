PERX_ENV=production
PERX_HUB_PATH=/opt/perx-hub
PERX_HUB_HOST=0.0.0.0
PERX_HUB_PORT=8080
PERX_EMAIL_WORKER_URL=http://localhost:5001
PERX_WA_BRIDGE_URL=http://localhost:5002
PERX_AUTO_UPDATER_URL=http://localhost:8084
PERX_REPO_PATH=/opt/perx-hub/repo
SUPABASE_URL=https://your-project-ref.supabase.co
# Copia questo file in .env (gitignored). Per l'Hub avviato da LaunchDaemon imposta anche le stesse chiavi in Resources/com.perx.hub.plist.
# Obbligatorio: chiave "service_role" da Supabase → Settings → API (non la anon).
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
